# ==============================================================================
# SecureTwinGrid - Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="SecureTwinGrid"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="securetwingrid-research-development-secret-key-do-not-use-in-prod"

# Backend Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="securetwingrid_db"

# Complete SQLAlchemy Database URI
# # For local PostgreSQL instance:
# DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/securetwingrid_db"
# # Fallback / Quick local test with SQLite (if PostgreSQL is not immediately running):
DATABASE_URL="sqlite:///./securetwingrid.db"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Frontend Public API URL (used by Vite)
VITE_API_BASE_URL="http://localhost:8000"
