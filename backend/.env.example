PROJECT_NAME="SecureTwinGrid Backend"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="securetwingrid_db"

# # Complete Database URI
# DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/securetwingrid_db"
# # Fallback local sqlite:
DATABASE_URL="sqlite:///./securetwingrid.db"

# Allowed CORS Origins (JSON formatted array or comma-separated strings)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
